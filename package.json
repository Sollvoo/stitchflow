{
  "name": "stitchflow-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "StitchFlow Desktop - Convert SVG/PNG/PDF to embroidery PES files",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:mac-intel": "electron-builder --mac --x64",
    "build:mac-arm": "electron-builder --mac --arm64",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Hugo Bonnet",
  "license": "MIT",
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "extends": null,
    "appId": "com.stitchflow.desktop",
    "productName": "StitchFlow",
    "files": [
      "assets/**/*",
      "electron/**/*",
      "src/**/*",
      "vendor/**/*",
      "scripts/**/*",
      ".venv/**/*",
      "!src/frontend/node_modules/**/*",
      "!**/__pycache__/**/*",
      "!**/*.pyc",
      "!**/*.pyo",
      "!src/frontend/assets/**/*",
      "!.venv/lib/python*/site-packages/numba/**/*",
      "!.venv/lib/python*/site-packages/llvmlite/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/",
        "to": "vendor/",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ]
    },
    "dmg": {
      "title": "StitchFlow",
      "artifactName": "${productName}-${arch}.dmg",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
