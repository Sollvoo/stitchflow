{
  "name": "stitchflow-desktop",
  "version": "1.0.3",
  "private": true,
  "description": "StitchFlow Desktop - Convert SVG/PNG/PDF to embroidery PES files",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:mac-intel": "electron-builder --mac --x64",
    "build:mac-arm": "electron-builder --mac --arm64",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Hugo Bonnet",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "extends": null,
    "appId": "com.stitchflow.desktop",
    "productName": "StitchFlow",
    "asar": false,
    "afterPack": "scripts/adhoc-sign-macos.js",
    "files": [
      "assets/**/*",
      "electron/**/*",
      "src/**/*",
      "vendor/**/*",
      "scripts/**/*",
      "!src/frontend/node_modules/**/*",
      "!**/__pycache__/**/*",
      "!**/*.pyc",
      "!**/*.pyo",
      "!src/frontend/assets/**/*",
      "!vendor/poppler-*/Library/share/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/",
        "to": "vendor/",
        "filter": ["**/*"]
      },
      {
        "from": ".venv/",
        "to": ".venv/",
        "filter": [
          "**/*",
          "!**/__pycache__/**/*",
          "!**/*.pyc",
          "!**/*.pyo",
          "!lib/python*/site-packages/numba/**/*",
          "!lib/python*/site-packages/llvmlite/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "artifactName": "${productName}-${arch}.${ext}",
      "target": [
        "zip"
      ]
    },
    "dmg": {
      "title": "StitchFlow",
      "artifactName": "${productName}-${arch}.dmg",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Sollvoo",
      "repo": "stitchflow"
    }
  }
}
