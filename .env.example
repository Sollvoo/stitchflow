# Django
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
# SQLite par défaut (MVP)
# DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (Phase 6+)
# DATABASE_URL=postgresql://user:password@localhost:5432/stitchflow

# Redis (broker Celery)
REDIS_URL=redis://localhost:6379/0

# Ink/Stitch — chemin vers l'exécutable inkstitch
# macOS (Homebrew Inkscape + extension Ink/Stitch) :
#   INKSTITCH_EXECUTABLE=/Users/<user>/Library/Application Support/org.inkscape.Inkscape/config/inkscape/extensions/inkstitch/inkstitch.app/Contents/MacOS/inkstitch
# Si inkstitch est dans le PATH :
#   INKSTITCH_EXECUTABLE=inkstitch
INKSTITCH_EXECUTABLE=inkstitch

# Timeout conversion en secondes (défaut : 120)
INKSTITCH_TIMEOUT=120
